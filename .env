# ---------------------------------------------------------------------------
# Pluto backend (uvicorn main:app --port 5000).
# start_servers.bat runs this service with cwd = web/backend, so plain
# load_dotenv() in database.py / auth_utils.py reads THIS file, not the repo
# root one. email_service.py and routes/oauth.py load it by absolute path.
# ---------------------------------------------------------------------------

# --- MongoDB ---
# Empty = the in-memory fallback in database.py (the app runs, but every
# user, upload and quiz result is lost on restart). No mongod is running on
# this machine and no Atlas URI was configured, so it stays empty.
MONGODB_URI=
MONGODB_DB_NAME=study_mind_db
# Local mongod instead:
# MONGODB_URI=mongodb://localhost:27017
# USE_LOCAL_MONGO=1

# --- Secrets ---
# auth_utils.py raises at import time if either of these is missing, which is
# why the backend could not start before: this file did not exist.
# JWT_SECRET_KEY must stay identical to the repo-root .env, because the
# rag-engine verifies the tokens this service signs.
JWT_SECRET_KEY=SbIUj2KN5zSqcHW_ebDbANy0eX9xfgzaXVOBOpXVJqUbqmIszT0as8z7q2eLIEdg
INTERNAL_SERVICE_KEY=REBVYqIKCVnxGTcvzKwmizpj_rcrgr1TxX5lQqyHWhI

# --- Downstream microservices ---
WEB_API_URL=http://localhost:5000
CHATBOT_SERVICE_URL=http://localhost:8000
INGESTION_SERVICE_URL=http://localhost:8001
QUIZ_SERVICE_URL=http://localhost:8002
ROADMAP_SERVICE_URL=http://localhost:8004

# --- Groq (flashcard generation) ---
# Empty on purpose: /flashcards/ai-status then reports "not configured" and
# generation falls back to template cards, instead of failing on a bad key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Email OTP verification ---
# email_service.py reads SMTP_USER / SMTP_PASSWORD. The Gmail app password
# was previously under EMAIL_USER / EMAIL_PASS, which no code reads, so OTP
# email silently logged to the console instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=quantumlogicslimited@gmail.com
SMTP_PASSWORD=guadmexqqkkbifoa

# --- OAuth sign-in (leave unset until you have real client credentials;
# the routes then redirect with ?error=..._oauth_not_configured) ---
FRONTEND_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/auth/github/callback

# --- Vector store (shared with the ai-ml and chatbot services) ---
CHROMA_DB_PATH=C:\QuantumLogicsLabs\QuantumLearningWorkspace\chroma_data
